{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "py-harness: ask",
      "type": "shell",
      "command": "__RUNNER__ ask \"${workspaceFolder}\" \"${input:task}\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "py-harness: run",
      "type": "shell",
      "command": "__RUNNER__ run \"${workspaceFolder}\" \"${input:task}\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "py-harness: brief",
      "type": "shell",
      "command": "__RUNNER__ brief \"${workspaceFolder}\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ],
  "inputs": [
    {
      "id": "task",
      "description": "What should py-harness do?",
      "type": "promptString",
      "default": "add multiply(a, b) and a unit test"
    }
  ]
}
